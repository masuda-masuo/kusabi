{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "summary",
    "findings",
    "next_steps"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "approve",
        "approve-partial",
        "needs-attention",
        "discard"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "title",
          "body",
          "file",
          "line_start",
          "line_end",
          "confidence",
          "recommendation"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "mechanical",
              "design"
            ],
            "description": "mechanical = the fix is prescribed by the finding itself (rename, registration, message fix, dead code removal); design = fixing it requires a decision the finding does not itself make. When unsure, use design. Optional: old records and lenient recovery parses without it stay valid, and a missing/invalid kind is treated as design at the consumption point."
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "description": "Repository-relative path to the affected file, e.g. \"src/foo.js\" not \"/workspace/src/foo.js\""
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "recommendation": {
            "type": "string"
          }
        }
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unverified": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "discard_reason": {
      "type": "string",
      "enum": [
        "wrong_premise",
        "needs_stronger_model"
      ]
    }
  },
  "if": {
    "properties": {
      "verdict": { "const": "discard" }
    },
    "required": ["verdict"]
  },
  "then": {
    "required": ["discard_reason"]
  }
}
